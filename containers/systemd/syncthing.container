[Unit]
Description=podman syncthing container service
StartLimitIntervalSec=120s
StartLimitBurst=10

[Quadlet]
# This skips waiting on podman-user-wait-network-online.service, which
# is buggy.
#
# https://blog.podman.io/2024/10/podman-5-3-changes-for-improved-networking-experience-with-pasta/
# https://github.com/podman-container-tools/podman/issues/24796#issuecomment-2527769896
DefaultDependencies=false

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=900

[Container]
Image=docker.io/linuxserver/syncthing:1.28.1
Network=host

User=root
Environment=STGUIADDRESS=127.0.0.1:8384
Environment=PUID=%U
Environment=PGID=%G
UserNS=keep-id:uid=%U,gid=%G
Volume=%h/.config/syncthing:/config:Z
Volume=%h/sync:%h/sync:z

[Install]
WantedBy=default.target
